NODE_ENV=development
PORT=3001

# Comma-separated browser origins allowed to call the web backend.
# Native iOS app requests do not use browser CORS.
CORS_ALLOWED_ORIGINS=https://homyforme.com,https://www.homyforme.com,http://localhost:5173

# Shared bearer token for all /api/auth/* routes.
# In production, set the same value in the iOS app config as AUTH_API_BEARER_TOKEN.
AUTH_API_BEARER_TOKEN=

# Only use this for local development when AUTH_API_BEARER_TOKEN is empty.
AUTH_API_ALLOW_UNPROTECTED=1

# Temporary file store. Use a mounted volume for experiments, then move to a database.
AUTH_STORE_PATH=server/data/auth-users.json

GOOGLE_AUTH_ALLOWED_CLIENT_IDS=
GOOGLE_SCRIPT_URL=
UNSUBSCRIBE_SECRET=
UNSUBSCRIBE_STORE_PATH=server/data/unsubscribed.json

APPLE_AUTH_ALLOWED_AUDIENCES=com.cirett.homy

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HOMY

# Phone sign-in is intentionally off for this launch version.
PHONE_AUTH_ENABLED=0

# Required before public launch in Germany.
# Use a complete serviceable postal address for Impressum and privacy pages.
VITE_LEGAL_SERVICE_ADDRESS=
VITE_LEGAL_SERVICE_ADDRESS_DE=

# Public App Store product URL.
VITE_APP_STORE_URL=
